#! /usr/bin/env bash

echo "DEBUG: kconfiglib kconfig-conf wrapper, arguments: ${@}"
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

# NuttX's generated apps/Kconfig contains absolute POSIX paths, so the Kconfig
# step needs an MSYS-aware python (not the native Windows one used by PX4).
export APPSDIR="`pwd`/../apps"

if [ -x /usr/bin/python3 ]; then
	PYTHON_EXECUTABLE=/usr/bin/python3
elif command -v python3 >/dev/null 2>&1; then
	PYTHON_EXECUTABLE=python3
else
	PYTHON_EXECUTABLE=python
fi

if [ "${1}" = "--olddefconfig" ]; then
	PYTHONPATH=${DIR} ${PYTHON_EXECUTABLE} ${DIR}/olddefconfig.py > /dev/null
else
	echo "ERROR: ${@} unsupported"
	exit 1
fi
